{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"roleId": {
			"description": "Unique identifier for role",
			"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
			"type": "string",
			"format": "uuid"
		},
		"workspaceId": {
			"description": "Unique identifier for workspace",
			"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
			"type": "string",
			"format": "uuid"
		},
		"organizationIds": {
			"description": "The IDs of the organizations to assign to the role",
			"example": [
				"96738ebc-7da1-48e2-8685-705c7b9268cb",
				"96738ebc-7da1-48e2-8685-705c7b9268cb"
			],
			"type": "array",
			"items": {
				"description": "Unique identifier for organization",
				"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
				"type": "string",
				"format": "uuid"
			}
		},
		"organizations": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"organizationId": {
						"description": "Unique identifier for organization",
						"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
						"type": "string",
						"format": "uuid"
					},
					"workspaceId": {
						"description": "Unique identifier for workspace",
						"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
						"type": "string",
						"format": "uuid"
					},
					"name": { "type": "string" },
					"email": {
						"anyOf": [
							{
								"example": "example@email.com",
								"type": "string",
								"format": "email"
							},
							{ "type": "null" }
						]
					},
					"phone": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"iso": {
										"description": "The ISO 3166-1 country code.",
										"example": "BR",
										"type": "string"
									},
									"ddi": {
										"description": "The international dialing code for the country, prefixed by the plus sign (+).",
										"example": "+55",
										"type": "string"
									},
									"number": { "type": "string" }
								},
								"required": ["iso", "ddi", "number"]
							},
							{ "type": "null" }
						]
					},
					"document": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"number": { "type": "string" },
									"type": {
										"type": "string",
										"enum": ["INDIVIDUAL", "COMPANY"]
									}
								},
								"required": ["number", "type"]
							},
							{ "type": "null" }
						]
					},
					"logo": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
					"domain": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
					"status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
					"deletedAt": {
						"anyOf": [
							{ "type": "string", "format": "date-time" },
							{ "type": "null" }
						]
					},
					"createdAt": { "type": "string", "format": "date-time" },
					"updatedAt": { "type": "string", "format": "date-time" }
				},
				"required": [
					"organizationId",
					"workspaceId",
					"name",
					"status",
					"createdAt",
					"updatedAt"
				]
			}
		},
		"permissionIds": {
			"description": "The IDs of the permissions to assign to the role",
			"example": ["user:read", "organization:read"],
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"user:create",
					"user:read",
					"user:update",
					"user:delete",
					"workspace:manage",
					"workspace:create",
					"workspace:read",
					"workspace:update",
					"workspace:delete",
					"organization:manage",
					"organization:create",
					"organization:read",
					"organization:update",
					"organization:delete",
					"role:create",
					"role:read",
					"role:update",
					"role:delete",
					"invoice:read",
					"subscription:create",
					"subscription:read",
					"subscription:update:plan",
					"subscription:update:payment-method",
					"subscription:delete"
				]
			}
		},
		"permissions": {
			"default": [],
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"permissionId": {
						"type": "string",
						"enum": [
							"user:create",
							"user:read",
							"user:update",
							"user:delete",
							"workspace:manage",
							"workspace:create",
							"workspace:read",
							"workspace:update",
							"workspace:delete",
							"organization:manage",
							"organization:create",
							"organization:read",
							"organization:update",
							"organization:delete",
							"role:create",
							"role:read",
							"role:update",
							"role:delete",
							"invoice:read",
							"subscription:create",
							"subscription:read",
							"subscription:update:plan",
							"subscription:update:payment-method",
							"subscription:delete"
						]
					},
					"subject": {
						"type": "string",
						"enum": [
							"user",
							"workspace",
							"organization",
							"role",
							"invoice",
							"subscription"
						]
					},
					"action": {
						"description": "Depends on the subject. Common values include: read, write, update, delete.",
						"examples": ["read"],
						"type": "string"
					},
					"title": {
						"description": "Human-readable name of the permission.",
						"type": "string"
					},
					"description": {
						"description": "Detailed explanation of what the permission allows within the system.",
						"type": "string"
					}
				},
				"required": [
					"permissionId",
					"subject",
					"action",
					"title",
					"description"
				]
			}
		},
		"name": { "type": "string" },
		"tags": { "default": [], "type": "array", "items": { "type": "string" } },
		"status": {
			"default": "ACTIVE",
			"type": "string",
			"enum": ["ACTIVE", "INACTIVE"]
		},
		"deletedAt": {
			"anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
		},
		"createdAt": { "type": "string", "format": "date-time" },
		"updatedAt": { "type": "string", "format": "date-time" }
	},
	"required": [
		"roleId",
		"workspaceId",
		"organizationIds",
		"permissionIds",
		"name",
		"createdAt",
		"updatedAt"
	],
	"x-readme-ref-name": "Role"
}
