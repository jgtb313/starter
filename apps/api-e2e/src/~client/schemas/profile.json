{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"userId": {
			"description": "Unique identifier for user",
			"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
			"type": "string",
			"format": "uuid"
		},
		"workspaceId": {
			"anyOf": [
				{
					"description": "Unique identifier for workspaceId",
					"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
					"type": "string",
					"format": "uuid"
				},
				{ "type": "null" }
			]
		},
		"scopes": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"kind": { "type": "string", "enum": ["WORKSPACE", "ORGANIZATION"] },
					"organizationId": {
						"anyOf": [
							{
								"description": "Unique identifier for organization",
								"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
								"type": "string",
								"format": "uuid"
							},
							{ "type": "null" }
						]
					},
					"permissions": { "type": "array", "items": { "type": "string" } }
				},
				"required": ["kind", "permissions"]
			}
		},
		"name": { "type": "string" },
		"email": {
			"example": "example@email.com",
			"type": "string",
			"format": "email"
		},
		"phone": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"iso": {
							"description": "The ISO 3166-1 country code.",
							"example": "BR",
							"type": "string"
						},
						"ddi": {
							"description": "The international dialing code for the country, prefixed by the plus sign (+).",
							"example": "+55",
							"type": "string"
						},
						"number": { "type": "string" }
					},
					"required": ["iso", "ddi", "number"]
				},
				{ "type": "null" }
			]
		},
		"birthday": {
			"anyOf": [
				{
					"anyOf": [
						{ "type": "string" },
						{ "type": "string", "format": "date-time" }
					]
				},
				{ "type": "null" }
			]
		},
		"document": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"number": { "type": "string" },
						"type": { "type": "string", "enum": ["INDIVIDUAL", "COMPANY"] }
					},
					"required": ["number", "type"]
				},
				{ "type": "null" }
			]
		},
		"avatar": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
		"localePreference": {
			"anyOf": [
				{ "type": "string", "enum": ["en", "es", "pt-BR"] },
				{ "type": "null" }
			]
		},
		"status": {
			"default": "ONBOARDING",
			"type": "string",
			"enum": ["ONBOARDING", "ACTIVE", "INACTIVE"]
		}
	},
	"required": ["userId", "scopes", "name", "email"],
	"x-readme-ref-name": "Profile"
}
