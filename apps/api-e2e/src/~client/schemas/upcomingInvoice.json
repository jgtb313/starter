{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"anyOf": [
		{
			"title": "InvoiceCard",
			"type": "object",
			"properties": {
				"invoiceId": {
					"description": "Temporary identifier for an upcoming invoice that has not yet been generated.",
					"example": "draft-9f8a7b6c-1234-4e89-b567-abcdef123456",
					"type": "string"
				},
				"workspaceId": {
					"description": "Unique identifier for workspace",
					"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
					"type": "string",
					"format": "uuid"
				},
				"subscriptionId": {
					"description": "Unique identifier for subscription",
					"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
					"type": "string",
					"format": "uuid"
				},
				"planId": {
					"description": "Unique identifier for plan",
					"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
					"type": "string",
					"format": "uuid"
				},
				"plan": {
					"type": "object",
					"properties": {
						"planId": {
							"description": "Unique identifier for plan",
							"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
							"type": "string",
							"format": "uuid"
						},
						"externalId": { "type": "string" },
						"name": { "type": "string" },
						"description": { "type": "string" },
						"features": {
							"type": "array",
							"items": {
								"anyOf": [
									{
										"type": "object",
										"properties": {
											"planFeatureId": {
												"description": "Unique identifier for planFeature",
												"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
												"type": "string",
												"format": "uuid"
											},
											"description": { "type": "string" },
											"feature": {
												"type": "string",
												"const": "ORGANIZATION_COUNT"
											},
											"props": {
												"type": "object",
												"properties": {
													"maxOrganizations": {
														"type": "number",
														"exclusiveMinimum": 0
													}
												},
												"required": ["maxOrganizations"]
											},
											"createdAt": { "type": "string", "format": "date-time" },
											"updatedAt": { "type": "string", "format": "date-time" }
										},
										"required": [
											"planFeatureId",
											"description",
											"feature",
											"props",
											"createdAt",
											"updatedAt"
										]
									}
								]
							}
						},
						"intervals": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"planIntervalId": {
										"description": "Unique identifier for planInterval",
										"example": "96738ebc-7da1-48e2-8685-705c7b9268cb",
										"type": "string",
										"format": "uuid"
									},
									"externalId": { "type": "string" },
									"amount": { "type": "number", "minimum": 0 },
									"interval": {
										"type": "string",
										"enum": ["DAY", "WEEK", "MONTH", "YEAR"]
									},
									"intervalCount": { "type": "number" },
									"trialDays": { "default": 7, "type": "number" },
									"status": {
										"default": "ACTIVE",
										"type": "string",
										"enum": ["ACTIVE", "INACTIVE"]
									},
									"createdAt": { "type": "string", "format": "date-time" },
									"updatedAt": { "type": "string", "format": "date-time" }
								},
								"required": [
									"planIntervalId",
									"externalId",
									"amount",
									"interval",
									"intervalCount",
									"createdAt",
									"updatedAt"
								]
							}
						},
						"highlight": { "default": false, "type": "boolean" },
						"default": { "default": false, "type": "boolean" },
						"status": {
							"default": "ACTIVE",
							"type": "string",
							"enum": ["ACTIVE", "INACTIVE"]
						},
						"deletedAt": {
							"anyOf": [
								{ "type": "string", "format": "date-time" },
								{ "type": "null" }
							]
						},
						"createdAt": { "type": "string", "format": "date-time" },
						"updatedAt": { "type": "string", "format": "date-time" }
					},
					"required": [
						"planId",
						"externalId",
						"name",
						"description",
						"createdAt",
						"updatedAt"
					]
				},
				"amount": { "type": "number", "exclusiveMinimum": 0 },
				"paymentMethod": { "type": "string", "const": "CARD" },
				"card": {
					"type": "object",
					"properties": {
						"token": {
							"description": "Token representing a securely stored payment card, typically returned by a payment provider.",
							"examples": ["tok_1N6zXeF6L3aBcD9X3gT2V9pQ"],
							"type": "string"
						},
						"number": {
							"description": "Masked card number for secure display.",
							"examples": ["5555 ********* 55"],
							"type": "string"
						},
						"holderName": {
							"description": "Name of the cardholder as printed on the card.",
							"examples": ["John Doe"],
							"type": "string"
						},
						"expirationDate": {
							"description": "Card expiration date in MM/YY format.",
							"examples": ["12/27"],
							"type": "string"
						}
					},
					"required": ["token", "number", "holderName", "expirationDate"]
				},
				"dueDate": { "type": "string", "format": "date-time" },
				"status": { "default": "OPEN", "type": "string", "enum": ["OPEN"] }
			},
			"required": [
				"invoiceId",
				"workspaceId",
				"subscriptionId",
				"planId",
				"plan",
				"amount",
				"paymentMethod",
				"card",
				"dueDate"
			]
		},
