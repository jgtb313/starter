{
  "name": "@starter/lambda-service-example",
  "version": "1.0.0",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "yarn build && serverless invoke local --function service --path event.json",
    "build": "tsc -p tsconfig.build.json",
    "deploy": "serverless deploy",
    "test": "vitest run",
    "test:ui": "vitest --watch --coverage --ui",
    "test:coverage": "vitest --watch --coverage",
    "test:watch": "vitest --watch --coverage",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.0.0",
    "@starter/common": "*",
    "@starter/config": "*",
    "@starter/domain": "*",
    "@starter/schema": "*",
    "@starter/nestjs-error-handling": "*",
    "@starter/nestjs-serverless-hoisting": "*",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/node": "^22.14.0",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/ui": "^2.1.8",
    "typescript": "5.4.2",
    "vite": "6.0.5",
    "vitest": "^2.1.8"
  }
}
