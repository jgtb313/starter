{
	"name": "@starter/lambda-example-service",
	"version": "1.0.0",
	"author": "João <jgtb313@gmail.com>",
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"deploy": "serverless deploy",
		"dev": "yarn build && serverless invoke local --function service --path event.json",
		"test": "vitest run",
		"test:coverage": "vitest --watch --coverage",
		"test:ui": "vitest --watch --coverage --ui",
		"test:watch": "vitest --watch --coverage",
		"type-check": "tsc --project tsconfig.json --pretty --noEmit"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/testing": "^11.1.6",
		"@starter/common": "workspace:*",
		"@starter/config": "workspace:*",
		"@starter/domain": "workspace:*",
		"@starter/i18n": "workspace:*",
		"@starter/nestjs-error-handling": "workspace:*",
		"@starter/nestjs-i18n": "workspace:*",
		"@starter/nestjs-serverless-hoisting": "workspace:*",
		"@starter/schema": "workspace:*",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@types/aws-lambda": "8.10.149",
		"@types/node": "^22.14.0",
		"@vitest/coverage-c8": "^0.33.0",
		"@vitest/ui": "^2.1.8",
		"serverless": "^3.38.0",
		"serverless-dotenv-plugin": "^6.0.0",
		"typescript": "5.4.2",
		"vite": "6.0.5",
		"vitest": "^2.1.8"
	}
}
