<!DOCTYPE html>
<html>
  <%- include('./content/head') %>

  <body bgcolor="#fafafa">
    <table bgcolor="#f1f1f1" cellspacing="0" cellpadding="0" width="650" style="width: 650px; margin: 0 auto; line-height: 25px">
      <tbody>
        <%- include('./content/header') %>

        <tr bgcolor="#f1f1f1">
          <td style="padding: 50px 80px 0 80px">
            <p
              style="
                font-size: 24px;
                font-family: 'Manrope', sans-serif;
                color: #707070;
                font-weight: 300;
                display: block;
                margin-bottom: 40px;
                margin-top: 0;
              "
            >
              <strong> Código de verificação </strong>
            </p>
            <p
              style="
                font-size: 15px;
                color: #707070;
                font-family: 'Manrope', sans-serif;
                font-weight: 300;
                display: inline-block;
                margin-bottom: 20px;
                margin-top: 0;
              "
            >
              Use o código informado neste email para autorizar o acesso à sua conta.
            </p>
            <p style="background-color: #fff; padding-top: 20px; padding-bottom: 20px; text-align: center; color: #db1924; font-size: 40px">
              <strong><%= code %></strong>
            </p>
            <p
              style="
                font-size: 15px;
                color: #707070;
                font-family: 'Manrope', sans-serif;
                font-weight: 300;
                display: inline-block;
                margin-bottom: 20px;
                margin-top: 0;
              "
            >
              Este código é válido por <strong>10 minutos</strong>, contados a partir do recebimento deste e-mail.
            </p>
            <br />
            <br />
            <br />
          </td>
        </tr>

        <%- include('./content/footer') %>
      </tbody>

      <tbody>
        <%- include('./content/help') %>
      </tbody>
    </table>
  </body>
</html>
