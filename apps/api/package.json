{
  "name": "@starter/api",
  "version": "1.0.0",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "node dist/src/index.js",
    "server": "nodemon --exec sucrase-node src/index.ts",
    "dev": "node concurrently.js",
    "generate:module": "yarn plop module",
    "generate:module:useCase": "yarn plop module:useCase",
    "build:artifacts": "yarn workspace @starter/shared build && yarn workspace @starter/schema build",
    "build": "tsc",
    "type-check": "tsc --project tsconfig.json --pretty --skipLibCheck --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage --watch",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.241.0",
    "@aws-sdk/s3-request-presigner": "^3.241.0",
    "@elastic/elasticsearch": "7.13.0",
    "@faker-js/faker": "^8.0.2",
    "@fastify/aws-lambda": "^3.5.0",
    "@fastify/cors": "^8.2.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^6.9.0",
    "@onesignal/node-onesignal": "^2.0.0-beta1",
    "@scalar/fastify-api-reference": "^1.22.38",
    "@starter/schema": "*",
    "@starter/shared": "*",
    "awilix": "^10.0.2",
    "axios": "0.27.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "10.0.0",
    "ejs": "^3.1.9",
    "fastify": "^4.24.3",
    "fastify-zod": "^1.4.0",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "ksuid": "^3.0.0",
    "module-alias": "2.2.2",
    "mongodb": "^5.6.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.1",
    "openapi-sampler": "^1.5.1",
    "plop": "^4.0.1",
    "qs": "^6.11.2",
    "redis": "^4.6.6",
    "write-yaml": "^1.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/ejs": "^3.1.2",
    "@types/form-data": "^2.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/module-alias": "2.0.1",
    "@types/node": "16.11.4",
    "@types/node-schedule": "^2.1.0",
    "@types/nodemailer": "^6.4.7",
    "@types/qs": "^6.9.7",
    "@vitest/coverage-c8": "^0.24.3",
    "concurrently": "^7.1.0",
    "nodemon": "2.0.14",
    "serverless": "^3.32.2",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.45.1",
    "serverless-offline": "^12.0.4",
    "sucrase": "^3.25.0",
    "typescript": "5.0.4",
    "vite": "^3.2.3",
    "vite-plugin-dts": "3.9.1",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^0.24.3"
  }
}
