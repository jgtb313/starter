{
  "name": "@starter/api",
  "version": "1.0.0",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "generate:module": "yarn plop module",
    "generate:module:useCase": "yarn plop module:useCase",
    "generate:adapter": "yarn plop adapter",
    "generate:port": "yarn plop port",
    "prebuild": "yarn workspace @starter/config build && yarn workspace @starter/shared build && yarn workspace @starter/schema build",
    "build": "ts-node scripts/load-envs && tsc",
    "type-check": "tsc --project tsconfig.json --pretty --skipLibCheck --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage --watch",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.241.0",
    "@aws-sdk/s3-request-presigner": "^3.241.0",
    "@fastify/aws-lambda": "^3.5.0",
    "@fastify/cors": "^8.2.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^6.9.0",
    "@scalar/fastify-api-reference": "^1.25.48",
    "@starter/config": "*",
    "@starter/schema": "*",
    "@starter/shared": "*",
    "axios": "0.27.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "10.0.0",
    "ejs": "^3.1.9",
    "fastify": "^4.24.3",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "ksuid": "^3.0.0",
    "module-alias": "2.2.2",
    "mongodb": "^5.6.0",
    "nodemailer": "^6.9.1",
    "openapi-sampler": "^1.5.1",
    "pino": "^9.5.0",
    "pino-elasticsearch": "^8.1.0",
    "plop": "^4.0.1",
    "qs": "^6.11.2",
    "redis": "^4.6.6",
    "twilio": "^5.3.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/ejs": "^3.1.2",
    "@types/form-data": "^2.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/module-alias": "2.0.1",
    "@types/node": "16.11.4",
    "@types/node-schedule": "^2.1.0",
    "@types/nodemailer": "^6.4.7",
    "@types/qs": "^6.9.7",
    "@vitest/coverage-v8": "^2.1.3",
    "mongodb-memory-server": "^10.0.1",
    "nodemon": "2.0.14",
    "ts-node": "^10.9.2",
    "typescript": "5.0.4",
    "vite": "^3.2.3",
    "vite-plugin-dts": "3.9.1",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^2.1.3"
  }
}
