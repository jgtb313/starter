{
  "name": "@starter/api",
  "version": "1.0.0",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "build:docs": "npx ts-node -r tsconfig-paths/register scripts/generate-docs.ts",
    "build": "nest build",
    "start": "node dist/main",
    "test": "vitest run",
    "test:ui": "vitest --watch --coverage --ui",
    "test:coverage": "vitest --watch --coverage",
    "test:watch": "vitest --watch --coverage",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.741.0",
    "@aws-sdk/s3-request-presigner": "3.741.0",
    "@casl/ability": "^6.7.3",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@starter/common": "workspace:*",
    "@starter/config": "workspace:*",
    "@starter/domain": "workspace:*",
    "@starter/nestjs-error-handling": "workspace:*",
    "@starter/nestjs-server-hoisting": "workspace:*",
    "@starter/schema": "workspace:*",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.8",
    "@types/node": "^22.10.7",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/ui": "^2.1.8",
    "globals": "^15.14.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.2",
    "vite": "6.0.5",
    "vitest": "^2.1.8"
  }
}
