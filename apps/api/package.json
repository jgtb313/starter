{
  "name": "@starter/api",
  "version": "1.0.0",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "generate:module": "yarn plop module",
    "generate:use-case": "yarn plop use-case",
    "generate:adapter": "yarn plop adapter",
    "generate:port": "yarn plop port",
    "copy-docs": "cp ./src/adapters/scalar/Scalar.docs.mdx ./dist/src/adapters/scalar/",
    "prebuild": "yarn workspace @starter/config build && yarn workspace @starter/emails-marketing build && yarn workspace @starter/shared build && yarn workspace @starter/schema build",
    "build": "tsc",
    "postbuild": "yarn copy-docs",
    "type-check": "tsc --project tsconfig.json --pretty --skipLibCheck --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage --watch",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^3.5.0",
    "@fastify/cors": "^8.2.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^6.9.0",
    "@scalar/fastify-api-reference": "^1.25.72",
    "@starter/config": "*",
    "@starter/schema": "*",
    "@starter/domain": "*",
    "@starter/emails-marketing": "*",
    "@starter/shared": "*",
    "dotenv": "10.0.0",
    "fastify": "^4.24.3",
    "module-alias": "2.2.2",
    "openapi-sampler": "^1.5.1",
    "plop": "^4.0.1"
  },
  "devDependencies": {
    "@types/form-data": "^2.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/module-alias": "2.0.1",
    "@types/node": "16.11.4",
    "@vitest/coverage-v8": "^2.1.3",
    "nodemon": "2.0.14",
    "ts-node": "^10.9.2",
    "typescript": "5.0.4",
    "vite": "^3.2.3",
    "vite-plugin-dts": "3.9.1",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^2.1.3"
  }
}
