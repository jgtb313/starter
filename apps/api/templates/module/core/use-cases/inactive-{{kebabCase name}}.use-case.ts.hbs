import { createUseCase } from '@/support/utilities'
import { IUseCaseExecute } from '@/core/shared/types'

const execute: IUseCaseExecute<Active{{pascalCase name}}Input, Active{{pascalCase name}}Output> =
  ({ Database }) =>
  async ({ id }) => {
    const {{camelCase name}} = await Database.{{camelCase name}}.findById(id)

    {{camelCase name}}.markAsInactive()

    const updated{{pascalCase name}} = await Database.{{camelCase name}}.updateById({{camelCase name}}.state.id, {{camelCase name}})

    return updated{{pascalCase name}}.state
  }

export const inactive{{pascalCase name}} = createUseCase(execute, Active{{pascalCase name}}Schema)
