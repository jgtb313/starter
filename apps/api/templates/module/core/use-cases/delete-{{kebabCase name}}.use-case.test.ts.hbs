import { beforeEach, describe, expect, it } from 'vitest'

import { TestDependencies, ITestDependencies } from '@/config/tests'
import { IDependencies } from '@/core/shared/types'

import { delete{{pascalCase name}} } from './delete-{{kebabCase name}}.use-case'

describe('delete{{pascalCase name}}', () => {
  const sut = () => ({
    execute: (input: Parameters<ReturnType<typeof delete{{pascalCase name}}>>[number]) => delete{{pascalCase name}}(dependencies as IDependencies)(input),
  })

  let dependencies: ITestDependencies

  beforeEach(async () => {
    dependencies = await TestDependencies()
  })

  it('should successfully delete a {{camelCase name}}', async () => {
    const input = { id: '1ylq82nZJybDbTZzEB6iBzbd5xF' }

    await sut().execute(input)

    expect(dependencies.Repositories.{{camelCase name}}.findById).toBeCalledWith(input.id)
    expect(dependencies.Repositories.{{camelCase name}}.deleteById).toBeCalledWith(input.id)
  })

  it('should throw an error if the {{camelCase name}} does not exist', async () => {
    const input = { id: 'nonexistent-{{camelCase name}}-id' }

    await expect(sut().execute(input)).rejects.toThrowError(`{{pascalCase name}} ${input.id} not found`)

    expect(dependencies.Repositories.{{camelCase name}}.findById).toBeCalledWith(input.id)
    expect(dependencies.Repositories.{{camelCase name}}.deleteById).not.toBeCalled()
  })
})
