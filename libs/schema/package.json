{
	"name": "@starter/schema",
	"version": "1.0.1",
	"author": "João <jgtb313@gmail.com>",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vitest --watch --coverage --ui",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"test": "vitest run",
		"test:ui": "vitest --coverage --ui",
		"test:coverage": "vitest --watch --coverage",
		"test:watch": "vitest --watch",
		"type-check": "tsc --project tsconfig.json --pretty --noEmit"
	},
	"dependencies": {
		"@starter/common": "workspace:*",
		"@starter/i18n": "workspace:*",
		"zod": "^4.1.1"
	},
	"devDependencies": {
		"@swc/core": "^1.10.1",
		"@vitest/coverage-v8": "^2.1.9",
		"@vitest/ui": "^2.1.9",
		"typescript": "5.4.2",
		"vite": "6.0.5",
		"vite-plugin-dts": "4.4.0",
		"vitest": "^2.1.9"
	},
	"main": "./dist/schema.cjs",
	"module": "./dist/schema.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/schema.cjs",
			"import": "./dist/schema.js"
		}
	},
	"typings": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	]
}
