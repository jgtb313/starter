{
  "name": "@starter/schema",
  "version": "1.0.1",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vitest --watch --coverage --ui",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:ui": "vitest --watch --coverage --ui",
    "test:coverage": "vitest --watch --coverage",
    "test:watch": "vitest --watch --coverage",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.6",
    "@starter/common": "workspace:*",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@types/lodash-es": "^4.17.12",
    "@types/omit-deep-lodash": "^1.1.3",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/ui": "^2.1.8",
    "typescript": "5.4.2",
    "vite": "6.0.5",
    "vite-plugin-dts": "4.4.0",
    "vitest": "^2.1.8"
  },
  "main": "./dist/schema.cjs",
  "module": "./dist/schema.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/schema.cjs",
      "import": "./dist/schema.js"
    }
  },
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ]
}
