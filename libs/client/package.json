{
  "name": "@starter/client",
  "version": "1.0.0",
  "author": "João <jgtb313@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prebuild": "node --loader ts-node/esm ./scripts/generate-resources.mts",
    "dev": "vite build --watch",
    "build": "vite build",
    "build:watch": "yarn prebuild && vite build --watch",
    "test": "vitest run",
    "test:ui": "vitest --watch --coverage --ui",
    "test:coverage": "vitest --watch --coverage",
    "test:watch": "vitest --watch --coverage",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit"
  },
  "dependencies": {
    "@starter/common": "*",
    "@starter/config": "*",
    "@starter/schema": "*",
    "axios": "1.7.9",
    "glob": "^11.0.1",
    "handlebars": "^4.7.8",
    "json-schema-to-zod": "^2.6.0",
    "nock": "^14.0.1",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "^7.5.2"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@types/node": "^22.13.1",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/ui": "^2.1.8",
    "ts-node": "^10.9.2",
    "typescript": "5.4.2",
    "vite": "6.0.5",
    "vite-plugin-dts": "4.4.0",
    "vitest": "^2.1.8"
  },
  "main": "dist/client.cjs",
  "module": "dist/client.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/client.cjs",
      "import": "./dist/client.js"
    }
  },
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ]
}
