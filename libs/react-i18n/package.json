{
	"name": "@starter/react-i18n",
	"version": "1.0.0",
	"author": "João <jgtb313@gmail.com>",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"type-check": "tsc --project tsconfig.json --pretty --noEmit"
	},
	"peerDependencies": {
		"react": "19.0.0",
		"react-dom": "19.0.0"
	},
	"dependencies": {
		"@starter/schema": "workspace:*",
		"@starter/i18n": "workspace:*"
	},
	"devDependencies": {
		"@swc/core": "1.2.165",
		"@vitejs/plugin-react": "4.3.4",
		"@types/react": "19.0.8",
		"@types/react-dom": "19.0.3",
		"typescript": "5.4.2",
		"vite": "6.0.5",
		"vite-plugin-dts": "4.4.0"
	},
	"main": "dist/react-i18n.cjs",
	"module": "dist/react-i18n.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/react-i18n.cjs",
			"import": "./dist/react-i18n.js"
		}
	},
	"typings": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	}
}
