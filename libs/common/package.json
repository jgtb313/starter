		"date-fns-tz": "^3.2.0",
		"flat": "^6.0.1",
		"lodash-es": "^4.17.21",
		"omit-deep-lodash": "^1.1.7",
		"pick-deep": "^1.0.0"
	},
	"devDependencies": {
		"@swc/core": "^1.10.1",
		"@types/lodash-es": "^4.17.12",
		"@types/omit-deep-lodash": "^1.1.3",
		"@vitest/coverage-v8": "2.1.9",
		"@vitest/ui": "^2.1.8",
		"typescript": "5.4.2",
		"vite": "6.0.5",
		"vite-plugin-dts": "4.4.0",
		"vitest": "^2.1.8"
