{
	"name": "@starter/i18n",
	"version": "1.0.0",
	"author": "João <jgtb313@gmail.com>",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"type-check": "tsc --project tsconfig.json --pretty --noEmit"
	},
	"dependencies": {
		"@starter/schema": "workspace:*",
		"@swc/core": "^1.2.165",
		"typesafe-i18n": "^5.26.2",
		"typescript": "5.4.2",
		"vite": "6.0.5",
		"vite-plugin-dts": "4.4.0"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.3.4"
	},
	"main": "dist/i18n.cjs",
	"module": "dist/i18n.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/i18n.cjs",
			"import": "./dist/i18n.js"
		}
	},
	"typings": "dist/index.d.ts",
	"files": [
		"dist"
	]
}
