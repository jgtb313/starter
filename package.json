{
	"name": "starter",
	"version": "1.0.0",
	"main": "index.js",
	"license": "MIT",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"libs/*"
		]
	},
	"scripts": {
		"x": "node run-command.js",
		"build:libs": "pnpm --filter \"./libs/*\" build",
		"dev:apps": "pnpm --filter \"./apps/api\" dev",
		"dev": "pnpm build:libs && pnpm dev:apps",
		"docker": "pnpm docker:down && pnpm docker:up",
		"docker:up": "docker-compose up -d",
		"docker:down": "docker-compose down",
		"docker:destroy": "docker-compose down --volumes --remove-orphans",
		"clean": "npm exec --workspaces -- npx rimraf node_modules && npm exec --workspaces -- npx rimraf dist"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"concurrently": "^9.1.0",
		"typescript": "5.4.2"
	},
	"dependencies": {
		"chalk": "^5.4.1"
	}
}
