{
  "name": "starter",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "artifacts/*"
    ]
  },
  "scripts": {
    "artifacts:build": "yarn workspace @starter/shared build && yarn workspace @starter/schema build && yarn workspace @starter/client build",
    "predev": "yarn artifacts:build",
    "dev": "node concurrently.js",
    "api:run": "yarn docker && node concurrently-api.js",
    "docker": "yarn docker:down && yarn docker:up",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:destroy": "docker-compose down --volumes --remove-orphans",
    "api:dev": "yarn workspace @starter/api dev",
    "client:dev": "yarn workspace @starter/client dev",
    "schema:dev": "yarn workspace @starter/schema dev",
    "shared:dev": "yarn workspace @starter/shared dev",
    "client:build": "yarn workspace @starter/client build",
    "schema:build": "yarn workspace @starter/schema build",
    "shared:build": "yarn workspace @starter/shared build",
    "api:build:artifacts": "yarn workspace @starter/api build:artifacts",
    "api:build": "yarn workspace @starter/api build",
    "api:deploy": "yarn workspace @starter/api deploy",
    "api:destroy": "yarn workspace @starter/api destroy",
    "clean": "npm exec --workspaces -- npx rimraf node_modules && npx rimraf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.41.0",
    "concurrently": "^7.1.0",
    "eslint": "^8.1.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "16.0.3",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.1",
    "prettier": "^2.8.0",
    "typescript": "5.0.4"
  }
}
