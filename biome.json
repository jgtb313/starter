{
	"$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
	"files": {},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":NODE:",
							":BLANK_LINE:",
							"@starter/config",
							"@starter/common",
							"@starter/nestjs-error-handling",
							"@starter/schema",
							"@starter/domain",
							"@starter/emails",
							"@starter/nestjs-server-hoisting",
							"@starter/nestjs-serverless-hoisting",
							"@starter/nestjs-i18n",
							"@starter/react-i18n",
							"@starter/i18n",
							"@starter/ui",
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							"@/~i18n/**",
							"@/support/**",
							"@/core/**",
							"@/adapters/**",
							"@/ports/**",
							"@/*",
							":BLANK_LINE:",
							["./**"],
							":BLANK_LINE:"
						]
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"nursery": {
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"attributes": ["className"],
						"functions": ["tv"]
					}
				}
			},
			"suspicious": {
				"noEmptyInterface": "off",
				"noArrayIndexKey": "warn"
			},
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "off",
				"useExhaustiveDependencies": "off",
				"noEmptyPattern": "off"
			},
			"style": {
				"useBlockStatements": "error",
				"noNonNullAssertion": "off"
			},
			"performance": {
				"noDelete": "off",
				"noAccumulatingSpread": "off"
			},
			"complexity": {
				"noBannedTypes": "off",
				"noStaticOnlyClass": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"attributePosition": "auto",
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"javascript": {
		"jsxRuntime": "transparent",
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"bracketSameLine": false,
			"attributePosition": "multiline",
			"expand": "always"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
